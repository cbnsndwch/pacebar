{
  "name": "pacebar-updates-worker",
  "private": true,
  "version": "0.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create pacebar-updates",
    "db:migrate": "wrangler d1 execute pacebar-updates --file schema.sql",
    "db:migrate:local": "wrangler d1 execute pacebar-updates --local --file schema.sql"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.158.0"
  }
}

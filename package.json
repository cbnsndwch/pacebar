{
  "name": "pacebar",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "typecheck": "tsc -b",
    "build:release": "./scripts/build-release.sh",
    "ccusage:bump": "node ./scripts/bump-ccusage-version.mjs",
    "version:bump": "node ./scripts/bump-version.mjs",
    "release:stats": "node ./scripts/release-stats.mjs",
    "bundle:plugins": "node copy-bundled.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage.enabled",
    "format": "oxfmt \"src/**/*.{ts,tsx}\" \"plugins/**/*.js\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"workers/**/*.{ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"plugins/**/*.js\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"workers/**/*.{ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "lint": "pnpm run lint:ts && pnpm run lint:rust",
    "lint:ts": "oxlint",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^22.2.7",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.28.0"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.18.0"
}

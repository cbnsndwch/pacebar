// Solution file. Carries no compiler options itself — it routes the TS server and
// `tsc -b` to the referenced projects. Order matters: app first (owns production
// files), spec second (owns the *.test.* / src/test files the app excludes), node last.
{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.spec.json" },
    { "path": "./tsconfig.node.json" }
  ]
}

# Use a hoisted (flat) node_modules layout instead of pnpm's strict symlinked one.
#
# Why: @testing-library/jest-dom augments vitest's `Assertion` interface via a
# cross-package `declare module 'vitest'`. Under pnpm's strict layout, jest-dom
# (isolated in its own .pnpm dir) and the test files resolve `vitest` through
# different paths, so the augmentation doesn't merge and every jest-dom matcher
# (toBeInTheDocument, ...) fails to type-check. The hoisted linker restores the
# flat layout where the augmentation resolves, with no loss of pnpm's workspace,
# lockfile, or content-addressable store benefits.
node-linker=hoisted
